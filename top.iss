; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Pinnacle Ledger"
#define MyAppVersion "1.0"
#define MyAppPublisher "Pinnacle System"
#define MyAppURL "github.com/can-daddy"
#define MyAppExeName "Main.exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".myp"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{C5979BFA-A6C9-4F6E-BD93-B38C6CE2CA15}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
ChangesAssociations=yes
DisableProgramGroupPage=yes
InfoBeforeFile=C:\Users\HP\3D Objects\Pinnacle Non-Profit\README.md
; Remove the following line to run in administrative install mode (install for all users.)
PrivilegesRequired=lowest
OutputDir=C:\Users\HP\3D Objects\Pinnacle Non-Profit
OutputBaseFilename=Pinnacle Ledger v1.0
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\account.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\add.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\budget.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\cancel.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\Delete.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\down-arrow.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\Edit.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\funds.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\More.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\PL_Logo.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\print.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\refresh.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Icons\wallet.svg"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\Pinnacle -Ledger Documentation.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\HP\3D Objects\Pinnacle Non-Profit\README.md"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".myp"; ValueData: ""

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

